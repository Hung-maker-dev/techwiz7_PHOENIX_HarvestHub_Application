APP_ENV=local
APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=harvesthub
DB_USER=root
DB_PASSWORD=

# OSRM endpoint reachable from this PHP server (not from the Flutter client).
OSRM_BASE_URL=http://127.0.0.1:5000
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Firebase Web API key from Firebase project settings.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# Firebase Cloud Messaging HTTP v1. Keep the service-account JSON outside
# the public web root and outside source control.
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_SERVICE_ACCOUNT_PATH=C:/secure/firebase/harvesthub-fcm-service-account.json

# Google AI Studio. Keep the key on the PHP server, never in Flutter.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=replace-with-google-ai-studio-key
AI_MODEL=gemini-2.0-flash

# Farmer approval email via Gmail SMTP. Generate an App Password in the
# sender Google account; never use or commit the account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HarvestHub
SMTP_ENCRYPTION=tls
